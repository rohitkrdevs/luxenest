0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"bg-[#F9F8F6] min-h-screen py-24 ","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 text-center","children":[["$","div",null,{"className":"space-y-4","children":[["$","span",null,{"className":"text-[10px] font-mono tracking-[0.25em] text-[#C2BCAE] uppercase block","children":"OUR STORY"}],["$","h1",null,{"className":"font-serif text-4xl sm:text-5xl font-light tracking-[0.12em] text-[#1A1A1A] uppercase","children":"About LuxeNest"}]]}],["$","div",null,{"className":"relative aspect-[16/9] bg-[#F1EFEA] rounded-sm overflow-hidden border border-[#EAE6DF]","children":["$","img",null,{"src":"/images/asset_5.jpg","alt":"LuxeNest Design Studio","className":"w-full h-full object-cover grayscale opacity-90"}]}],["$","div",null,{"className":"space-y-6 text-left","children":[["$","p",null,{"className":"text-sm text-[#7E756B] font-sans font-light leading-relaxed","children":"Founded in Copenhagen in 2024, LuxeNest emerged from a singular vision: to bridge the gap between high-end architectural furniture and accessible, direct-to-consumer delivery. We believe that a thoughtfully designed home nourishes the psyche, representing a shelter from the noise of the physical world."}],["$","p",null,{"className":"text-sm text-[#7E756B] font-sans font-light leading-relaxed","children":"Every framing joint carries our fully serialized timber brand to guarantee authentic old-world workshop fabrication. We specify solid stave ash and European beech derived entirely from woodlands overseen by the Forest Stewardship Council (FSC). This certifies that no ancient growth gets logged."}],["$","p",null,{"className":"text-sm text-[#7E756B] font-sans font-light leading-relaxed","children":"Our custom-milled Italian velvet weavings use high density natural wool, cotton, and linen threads that resist oil staining and static piling natively without synthetic chemical coatings. Quality is not just a promise; it is the foundation of our craft."}]]}]]}]}],null,["$","$L2",null,{"children":["$","$3",null,{"name":"Next.MetadataOutlet","children":"$@4"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"sbnsHbHbMwKFm3fmDMUzD"}
